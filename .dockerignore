# Only what scripts/Dockerfile copies.
**
!src/common/
!src/server/
!src/client/
!deps/thirdparty/
!web/
!scripts/fetch-sqlite.sh
!scripts/sqlite.version
!scripts/fetch-webp.sh
!scripts/build-webp.sh
!scripts/webp.version
!scripts/fetch-opus.sh
!scripts/opus.version
!scripts/version-defines.sh

# But no build output from a local build: the image builds its own, and a
# library built here (another libc, other flags) would be taken as current.
**/*.a
**/*.o
**/*.lib
**/*.obj
**/*.res
web/out/
web/deps/
