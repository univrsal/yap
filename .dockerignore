# Only what docker/Dockerfile copies.
**
!src/common/
!src/lib/
!src/server/
!src/client/
!deps/thirdparty/
!web/
!scripts/build/collections.sh
!scripts/build/fetch-sqlite.sh
!scripts/build/sqlite.version
!scripts/build/fetch-webp.sh
!scripts/build/build-webp.sh
!scripts/build/webp.version
!scripts/build/fetch-opus.sh
!scripts/build/opus.version
!scripts/build/version-defines.sh

# But no build output from a local build: the image builds its own, and a
# library built here (another libc, other flags) would be taken as current.
**/*.a
**/*.o
**/*.lib
**/*.obj
**/*.res
web/out/
web/deps/
