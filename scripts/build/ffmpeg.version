# The FFmpeg src/video (the optional yap_video library) is built against:
# read by scripts/build/fetch.sh (and with it build-video.sh) and by
# build-video.bat, so lines are name=value and nothing else.
#
# On Windows and Linux these are BtbN's LGPL shared builds
# (github.com/BtbN/FFmpeg-Builds): NVENC, AMF, QSV (libvpl), VA-API,
# D3D11VA and dav1d, nothing GPL. Its autobuild releases are only kept
# for a while (the daily ones for about two weeks, the one from each
# month's last days for much longer), so the files are also mirrored in
# yap's own releases (tag ffmpeg_mirror_tag, made by
# scripts/build/mirror-ffmpeg.sh), which the downloads try first. To
# move to a newer FFmpeg, pick a month-end autobuild's n8.1 lgpl-shared
# files and their sums from its checksums.sha256, then run
# mirror-ffmpeg.sh before pushing. The sums are checked whichever
# place the files came from.
#
# macOS has no such builds, so scripts/build/build-ffmpeg-macos.sh builds a
# small LGPL one from these sources (VideoToolbox, and dav1d for AV1).
#
# Stay on the 8.x branch: BtbN builds 8.0 and 8.1 against the NVENC 13.0
# headers (NVIDIA driver 570 or later) and 9.0 against 13.1, which needs
# driver 610, newer than most people have. Moving it means changing
# NVENC_API_* and NVENC_DRIVER in src/video/src/encoders.cpp too, and
# checking the versions src/video/src/ffmpeg.cpp takes (on Linux and
# macOS it falls back to the system's FFmpeg 8 or 9).
ffmpeg_release=autobuild-2026-10-31-12-59
ffmpeg_mirror_tag=deps-ffmpeg-8.1.3-27
ffmpeg_win=ffmpeg-n8.1.3-27-g8dca1586f4-win64-lgpl-shared-8.1
ffmpeg_win_sha256=5cef7bc48e513f3cee7c881e8b2999d835541edb1846c3e89443a67f8f8556ab
ffmpeg_linux=ffmpeg-n8.1.3-27-g8dca1586f4-linux64-lgpl-shared-8.1
ffmpeg_linux_sha256=493e89a48da02b9a7d217b60f7f60c3c917c9bed73459d8a106e5e987da082ef
ffmpeg_source=ffmpeg-8.1.3
ffmpeg_source_sha256=7138d28c96d9d3e3af4ee3d8cad72741f8ffb40da90c1112235dea3ecd3178a3
dav1d_source=dav1d-1.5.4
dav1d_version=1.5.4
dav1d_source_sha256=686616b7c69eb88d44459391ab25cac13b6647a3b288835c5784e71c1514a5c5
