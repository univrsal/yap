# Copy to .env next to docker-compose.yml and change what you need.

# The image to run.
#YAP_IMAGE=ghcr.io/univrsal/yap:latest

# The server's UDP ports: the main one, and video (screen sharing and cameras).
# They are applied on every start, and are the same inside and outside the
# container.
#YAP_PORT=7777
#YAP_VIDEO_PORT=7778

# The relay serves the web client and the bot API over plain HTTP on this TCP
# port. YAP_RELAY_ENABLED only takes effect when config.json is created; to
# change it later, edit relay.enabled in config.json in the data volume.
#YAP_RELAY_ENABLED=false
#YAP_RELAY_PORT=8080
# 127.0.0.1 publishes the relay only on this machine, e.g. behind nginx.
#YAP_RELAY_HOST_IP=127.0.0.1

# The owner account's password for a new server. If empty, a random one is
# printed to the log on the first start.
#YAP_INITIAL_ADMIN_PASSWORD=

# The proxy profile (docker compose --profile proxy up -d): nginx with a Let's
# Encrypt certificate in front of the relay, which needs YAP_RELAY_ENABLED=true
# for the web client. The domain has to point at this machine, and port 80
# has to be reachable from the internet for the certificate.
#YAP_DOMAIN=chat.example.org
# For Let's Encrypt's expiry warnings. Optional.
#YAP_CERT_EMAIL=
# Set to 1 to try it out with Let's Encrypt's staging certificates, which
# browsers don't trust but which aren't rate limited.
#YAP_CERT_STAGING=
#YAP_HTTP_PORT=80
#YAP_HTTPS_PORT=443
