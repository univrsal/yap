# The FFmpeg src/video (the optional yap_video library) is built against:
# read by scripts/fetch-ffmpeg.sh (and with it build-video.sh) and by
# build-video.bat, so lines are name=value and nothing else.
#
# On Windows and Linux these are BtbN's LGPL shared builds
# (github.com/BtbN/FFmpeg-Builds): NVENC, AMF, QSV (libvpl), VA-API,
# D3D11VA and dav1d, nothing GPL. Its autobuild releases are only kept
# for a while, so when the download stops working, pick a newer
# autobuild's n8.1 lgpl-shared files and their sums from its
# checksums.sha256.
#
# macOS has no such builds, so scripts/build-ffmpeg-macos.sh builds a
# small LGPL one from these sources (VideoToolbox, and dav1d for AV1).
#
# Stay on the 8.x branch: BtbN builds 8.0 and 8.1 against the NVENC 13.0
# headers (NVIDIA driver 570 or later) and 9.0 against 13.1, which needs
# driver 610, newer than most people have. Moving it means changing
# NVENC_API_* and NVENC_DRIVER in src/video/src/encoders.cpp too.
ffmpeg_release=autobuild-2026-10-12-13-12
ffmpeg_win=ffmpeg-n8.1.3-18-g46d899d7a0-win64-lgpl-shared-8.1
ffmpeg_win_sha256=fa628b9de20254fe7c80605a4c6af54d0bffdda0807363ee7557131c2b78e051
ffmpeg_linux=ffmpeg-n8.1.3-18-g46d899d7a0-linux64-lgpl-shared-8.1
ffmpeg_linux_sha256=650b22180f416eed5c700a0701c77a95ad191c8dc5f133653c93dd476d61a231
ffmpeg_source=ffmpeg-8.1.3
ffmpeg_source_sha256=7138d28c96d9d3e3af4ee3d8cad72741f8ffb40da90c1112235dea3ecd3178a3
dav1d_source=dav1d-1.5.4
dav1d_version=1.5.4
dav1d_source_sha256=686616b7c69eb88d44459391ab25cac13b6647a3b288835c5784e71c1514a5c5
